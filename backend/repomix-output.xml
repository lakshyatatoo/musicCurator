  ],
  "songRecommendations": [
    {"song": "Song Name", "artist": "Artist Name", "reason": "why this fits"},
    {"song": "Song Name", "artist": "Artist Name", "reason": "why this fits"},
    {"song": "Song Name", "artist": "Artist Name", "reason": "why this fits"},
